    <!-- 时间线说明与假设 -->
    <string name="journal_timeline_info_title">时间线说明</string>
    <string name="journal_timeline_assumptions_title">简化与假设条件</string>
    <string name="journal_timeline_assumptions_intro_1">为了能够根据既有数据绘制时间线，模型做出了多项\u0020</string>
    <string name="journal_timeline_assumptions_intro_bold">通常并不完全成立的</string>
    <string name="journal_timeline_assumptions_intro_2">\u0020简化假设：</string>
    <string name="journal_timeline_assumption_1">例如现在服用 x 剂量与稍后服用 x 剂量效果相同，假设不存在急性耐受。</string>
    <string name="journal_timeline_assumption_2">服用双倍剂量将产生双倍效果（线性假设）。</string>
    <string name="journal_timeline_assumption_3">PsychonautWiki 的时长范围适用于所有剂量级别。</string>
    <string name="journal_timeline_assumption_4">口服给药均默认为空腹状态，因此不会产生延迟（饱腹可能延迟长达 4 小时）。</string>
    <string name="journal_timeline_understanding_title">解读时间线</string>
    <string name="journal_timeline_understanding_1">时间线基于 PsychonautWiki 记录的起效期 (Onset)、爬升期 (Comeup)、峰值期 (Peak) 和退去期 (Offset)（有时包括总时长）进行绘制。</string>
    <string name="journal_timeline_understanding_2">在理想情况下，4 个阶段时长均有明确记录，完整时间线绘制为：平均起效期 -&gt; 平均爬升期 -&gt; 加权峰值期 -&gt; 加权退去期。其中“加权”是指根据剂量在参考区间内进行线性插值（阈值剂量取下限，极重剂量取上限，中间剂量线性过渡）。</string>
    <string name="journal_timeline_understanding_3">相同物质且相同给药途径、且 4 个阶段时长均完整记录的多次服用，将通过曲线叠加合并为累积时间线；若缺少任一阶段时长则不进行曲线叠加。</string>
    <string name="journal_timeline_understanding_4">不同给药途径即使属于同一种物质也始终作为独立时间线分开绘制。它们均占满画布高度，高度并不与剂量或效应大小成正比。</string>
    <string name="journal_timeline_understanding_5">如果 4 个阶段中有缺失但提供了总时长，则在遇到缺失阶段时会使用总时长推算终点并绘制虚线至结束；若总时长也未提供则直接截断。若时间线部分缺失，说明 PsychonautWiki 缺少对应数据；补充数据后将在下次更新中显示完整曲线。</string>
    <string name="journal_timeline_understanding_6">虚线部分的纵向走势未知。虚线表示药效在此时间段内的具体发展趋势尚不明确，仅明确其结束时间点。</string>
    <string name="journal_timeline_understanding_7">如果服用记录为一个时间范围且该途径数据完整，应用假设剂量在此时段内均匀摄入，并通过微元卷积计算累积效应曲线。</string>
    <string name="journal_timeline_pw_durations_title">PsychonautWiki 药效时长定义</string>
    <string name="journal_timeline_pw_durations_desc">药效时长是指精神活性物质主观效应显现并持续的时间长度。\n时长通常分为 6 个阶段：(1) 总时长 (2) 起效期 (3) 爬升期 (4) 峰值期 (5) 退去期 和 (6) 后效期。各阶段依物质特性连续演进。</string>
    <string name="journal_phase_total">总时长</string>
    <string name="journal_phase_total_desc">从首次给药开始，直至物质的主观效应完全消退恢复清醒所需的全部时间。</string>
    <string name="journal_phase_onset">起效期</string>
    <string name="journal_phase_onset_desc">从给药至首次能够察觉到感知觉发生变化（即初显感应 / First Alert）之间的时间段。</string>
    <string name="journal_phase_comeup">爬升期</string>
    <string name="journal_phase_comeup_desc">从首次明显感知变化至达到主观效应最强点之间的阶段，常被称为药效爬升。</string>
    <string name="journal_phase_peak">峰值期</string>
    <string name="journal_phase_peak_desc">物质效应强度维持在最高平台的持续时间段。</string>
    <string name="journal_phase_offset">退去期</string>
    <string name="journal_phase_offset_desc">从峰值平台期结束至完全恢复清醒之间的过渡时间段，常被称为药效退去（Coming down）。</string>
    <string name="journal_phase_afterglow">后效期</string>
    <string name="journal_phase_afterglow_desc">主体验结束后残留的后续身体或心理效应。依物质种类和使用方式不同，可能表现为宿醉感（Hangover）或积极的回甘充实感（Afterglow）。\n后效期不计入总时长之内。</string>

